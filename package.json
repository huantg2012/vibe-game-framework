    "check:ground-runtime": "tsx --tsconfig tools/contam-preview/tsconfig.json tools/contamination-lexicon/check-ground-runtime.ts",
    "check:physics-runtime": "tsx --tsconfig tools/contam-preview/tsconfig.json tools/contamination-lexicon/check-physics-runtime.ts",
