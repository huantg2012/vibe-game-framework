{
  "name": "coh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node tools/ensure-deps.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "codegen": "node tools/csv-codegen/generate.mjs",
    "art:postprocess": "tsx tools/art-pipeline/src/postprocess.ts",
    "art:verify": "tsx tools/art-pipeline/src/verify.ts",
    "preview:outline": "tsx --tsconfig tsconfig.json tools/map-preview/render-outline.ts",
    "check:outline": "tsx --tsconfig tsconfig.json tools/map-preview/check-outline.ts",
    "preview:ruins": "tsx --tsconfig tsconfig.json tools/map-preview/render-ruins.ts",
    "check:ruins": "tsx --tsconfig tsconfig.json tools/map-preview/check-ruins.ts",
    "preview:recipes": "tsx --tsconfig tsconfig.json tools/map-preview/render-recipe-drafts.ts",
    "check:recipes": "tsx --tsconfig tsconfig.json tools/map-preview/check-recipe-drafts.ts",
    "check:layout": "tsx --tsconfig tsconfig.json tools/map-preview/check-layout.ts",
    "preview:probes": "tsx --tsconfig tsconfig.json tools/map-preview/render-density-probes.ts"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.4.2",
    "tsx": "^4.0.0",
    "sharp": "^0.33.0"
  }
}
