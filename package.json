    "check:volume-seat": "tsx --tsconfig tools/contam-preview/tsconfig.json tools/contamination-lexicon/check-volume-seat.ts",
    "check:volume-deployment": "tsx --tsconfig tools/contam-preview/tsconfig.json tools/contamination-lexicon/check-volume-deployment.ts",
    "check:dust-motion": "tsx --tsconfig tools/contam-preview/tsconfig.json tools/contamination-lexicon/check-dust-motion.ts",
