import {createHash} from 'node:crypto';
import {readFileSync,writeFileSync} from 'node:fs';
import {buildNativeVolume} from '/Users/yilungao/coh/src/generation/world-study/native-volume-geometry.ts';
import {R100_NATIVE_WORLDS} from '/Users/yilungao/coh/src/generated/r100-native-worlds.ts';
const folder='/Users/yilungao/coh/docs/qa/artifacts/r100-i07-i09/b02-terrace-refined';
const hash=value=>createHash('sha256').update(value).digest('hex');
const fingerprint=mesh=>{const h=createHash('sha256');for(const k of['positions','normals','uv','indices','materials','regions'])h.update(new Uint8Array(mesh[k].buffer));h.update(JSON.stringify({bounds:mesh.bounds,joints:mesh.joints}));return h.digest('hex')};
const records=[];for(const world of R100_NATIVE_WORLDS.filter((_,i)=>i<24||_.id==='monolith-sill'))for(const definition of world.definitions){for(const seed of[20261005,20261217])for(const {role,...instance}of definition.instances){const spec={...instance,seed,family:instance.family??definition.family,blocking:role==='solid'?1:0};records.push({world:world.id,definition:definition.id,spec,sha256:fingerprint(buildNativeVolume(spec))});}}
const definitions=R100_NATIVE_WORLDS.filter((_,i)=>i<24||_.id==='monolith-sill').map(({id,profile,definitions})=>({id,sha256:hash(JSON.stringify({profile,definitions}))}));
if(process.argv.includes('--before')){writeFileSync(folder+'/protected-before.json',JSON.stringify({method:'Every instance and grade of original20+B01+monolith, two fixed diagnostic seeds; exact arrays, normals, UV, material slots, regions, bounds and joints. Not full-world qualification.',definitions,records},null,2)+'\n');console.log(`Captured ${records.length} exact meshes / ${definitions.length} world definitions`);}else{const before=JSON.parse(readFileSync(folder+'/protected-before.json','utf8'));if(JSON.stringify(before.records)!==JSON.stringify(records)||JSON.stringify(before.definitions)!==JSON.stringify(definitions))throw new Error('Protected geometry/definition changed');writeFileSync(folder+'/protected-after.json',JSON.stringify({status:'pass',worlds:definitions.length,geometryCases:records.length,beforeSha256:hash(readFileSync(folder+'/protected-before.json')),sourceHashes:Object.fromEntries(['src/generation/world-study/native-volume-geometry.ts','src/generation/world-study/native-volume-expansion.ts','src/generation/world-study/native-volume-cellular.ts'].map(path=>[path,hash(readFileSync('/Users/yilungao/coh/'+path))]))},null,2)+'\n');console.log(`PASS ${records.length} protected meshes / ${definitions.length} world definitions unchanged`);}
