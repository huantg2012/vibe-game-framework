:root{font-family:Inter,"PingFang SC","Microsoft YaHei",sans-serif;color:#dce5e8;background:#111719;font-synthesis:none;color-scheme:dark}*{box-sizing:border-box}body{margin:0}button,select,input{font:inherit}button,select{color:inherit;background:#222d31;border:1px solid #3b4c52;border-radius:5px;padding:8px 10px}button{cursor:pointer}button:hover{background:#2e4045}button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid #8bd4c2;outline-offset:3px}button[aria-pressed=true],button[aria-current=true]{background:#23483f;border-color:#7cbda9;color:#d3f4e9}button:disabled{opacity:.35;cursor:default}header{height:76px;display:flex;align-items:center;gap:22px;padding:0 24px;border-bottom:1px solid #2f3b3f}h1{font-size:20px;font-weight:550;margin:0}header p{font-size:13px;color:#8da0a6}header a{margin-left:auto;font-size:13px;color:#a7c0ba}main{display:grid;grid-template-columns:200px minmax(480px,1fr) 270px;min-height:calc(100vh - 76px)}nav{padding:18px 12px;border-right:1px solid #2f3b3f;max-height:calc(100vh - 76px);overflow:auto}nav h2{font-size:11px;letter-spacing:2px;color:#81979d;margin:20px 9px 10px}nav h2:first-child{margin-top:3px}nav button{display:block;width:100%;text-align:left;margin:4px 0;background:transparent;border-color:transparent;font-size:13px}nav button small{float:right;color:#8aaba0}.viewer{min-width:0;padding:20px;display:flex;flex-direction:column;gap:14px}.mode-row{display:flex;gap:8px;align-items:center}.mode-row span{margin-left:auto;font-size:12px;color:#8da0a6}#game-container{width:100%;aspect-ratio:3/2;display:flex;align-items:center;justify-content:center;background:#20272a;overflow:hidden;border-radius:8px}#game-container canvas{display:block;image-rendering:pixelated}#transport{display:flex;align-items:center;gap:8px}#timeline{flex:1;accent-color:#7cc4ad;min-width:40px}#progress{font-size:12px;width:40px;color:#9fb3b9}#phase-label{font-size:13px;color:#b7d1c8;min-height:20px}.hint{font-size:12px;line-height:1.8;color:#8da0a6;margin:0}aside{padding:24px 20px;border-left:1px solid #2f3b3f;max-height:calc(100vh - 76px);overflow:auto}aside h2{font-size:18px;font-weight:500;margin:0 0 5px}.eyebrow{font-size:11px;letter-spacing:1.5px;color:#7eaaa0;margin-bottom:12px}label{display:block;font-size:12px;color:#a3b5bb;margin:16px 0 7px}select{width:100%;font-size:13px}fieldset{border:0;margin:0;padding:0}fieldset:disabled{opacity:.4}.actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:16px 0}.actions button{font-size:12px}.check{display:flex;align-items:center;gap:8px}#live-state{white-space:pre-wrap;word-break:break-word;font-size:12px;line-height:1.6;color:#a6bbb3;border-top:1px solid #34434a;padding-top:12px}#error{color:#ffa997;font-size:13px} [hidden]{display:none!important}
/* This is a developer workbench; the game canvas keeps its 960 × 640 logical view. */
main{grid-template-columns:clamp(120px,16vw,200px) minmax(0,1fr) clamp(190px,24vw,270px)}.viewer{padding:16px}aside{padding:20px 14px}.mode-row{flex-wrap:wrap}.mode-row span{width:100%;margin-left:0}#transport{flex-wrap:wrap}#timeline{flex-basis:100px}header p{max-width:240px}nav button{padding:8px 7px}
